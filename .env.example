# Configuration de MIA (copier ce fichier en ".env" et adapter les valeurs)

# Fournisseur IA : "ollama" (local) ou "cloud" (en ligne)
LLM_PROVIDER=ollama

# Parametres Ollama (local, leger pour 8 Go RAM CPU)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Parametres Cloud (laisser vide si non utilise — ne jamais mettre de vraie cle ici)
CLOUD_API_KEY=
CLOUD_MODEL=

# Origines CORS autorisees (separees par des virgules, jamais "*")
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Outils fichiers locaux (desactives par defaut par securite)
ENABLE_LOCAL_TOOLS=false
SANDBOX_DIR=sandbox
