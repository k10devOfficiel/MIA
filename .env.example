# Configuration de MIA (copier ce fichier en ".env" et remplir les valeurs)

# Mode d'execution : development ou production
APP_ENV=development

# Fournisseur IA : ollama (local) ou cloud (en ligne)
LLM_PROVIDER=ollama

# Parametres Ollama (local, leger pour 8 Go RAM CPU)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Parametres Cloud (laisser vide si non utilise)
CLOUD_API_KEY=
CLOUD_MODEL=

# Chemin de la base de donnees SQLite
DATABASE_PATH=data/mia.db
